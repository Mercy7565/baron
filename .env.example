# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---- Razorpay (test mode) --------------------------------------------------
# From the Razorpay dashboard, Settings -> API Keys. Test mode only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# Settings -> Webhooks. Any string, as long as it matches the dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- App -------------------------------------------------------------------
NODE_ENV=development
# No trailing slash. On a deployment this is the public origin.
APP_BASE_URL=http://localhost:3000

# Signs the session, basket and wallet cookies. Any value; must be the same on
# every instance, and changing it signs everyone out.
SESSION_SECRET=baron-dev-session-secret
# Signs the two-round shop resume token. Same rule.
RESUME_SECRET=baron-dev-resume-secret

# ---- Storage ---------------------------------------------------------------
# Campaigns, catalog edits and the margin floor are shared state and must
# outlive one process. On a laptop they go in .data/ and that is enough.
#
# On a serverless host the disk is per-instance and thrown away, so attach a
# Vercel Blob store to the project — Storage -> Create -> Blob -> Connect — and
# Vercel injects this automatically. Without it the merchant console will say
# plainly that its edits are not being saved.
BLOB_READ_WRITE_TOKEN=

# Where the local store writes. Defaults to .data (or /tmp/baron on Vercel).
BARON_STORE_DIR=
