# ---- Razorpay (sandbox / test mode) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Database ----
DATABASE_URL=postgres://user:password@localhost:5432/countersign

# ---- App ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Audit log location (defaults to .data/audit.jsonl relative to cwd)
AUDIT_LOG_PATH=

# Signs the two-round shop resume token. Any value; must match across instances.
RESUME_SECRET=baron-dev-resume-secret
